[run]
source = .
omit =
    */migrations/*
    */__pycache__/*
    */tests*
    */test_*.py
    # Seed data script, not production code
    listings/management/commands/seed_demo.py

[report]
omit =
    */migrations/*
    */__pycache__/*
    */tests*
    */test_*.py
    listings/management/commands/seed_demo.py
