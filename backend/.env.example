# ReNest backend configuration.
# Copy to .env and fill in values. Never commit .env.

# ── Core Django ──────────────────────────────────────────────────────
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-for-production
DJANGO_ENVIRONMENT=development
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Absolute URL the frontend is served from — used in emails and deep links.
APP_BASE_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────
# Option A: single URL (takes precedence when set, e.g. on Render/Heroku)
# DATABASE_URL=postgres://user:password@host:5432/renest
# Option B: discrete Postgres settings
POSTGRES_DB=dormcycle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
# Option C: zero-setup local fallback (SQLite file in backend/)
USE_SQLITE=0
# Tests default to SQLite; set to 1 to run the test suite against Postgres.
USE_POSTGRES_FOR_TESTS=0

# ── Redis (cache, sessions, Celery broker, notification fan-out) ─────
# Optional in development — the app falls back to in-memory caching and
# eager Celery execution when unset.
# REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ── AI (Google Gemini) ───────────────────────────────────────────────
# Powers the concierge chat, room-scan detection, vision autofill,
# description writing, semantic search, and moderation pre-screen.
# Get a key at https://aistudio.google.com — all AI features degrade
# gracefully when unset.
GEMINI_API_KEY=
# Model overrides (defaults shown):
# AI_MODEL_FAST=gemini-flash-latest
# AI_MODEL_VISION=gemini-flash-latest
# AI_MODEL_EMBEDDING=gemini-embedding-001
# CONCIERGE_MODEL_REASONING=gemini-pro-latest
# CONCIERGE_MODEL_FAST=gemini-flash-latest
# CONCIERGE_ENABLED=1

# ── Email (SMTP) ─────────────────────────────────────────────────────
# Development default: console backend — emails print to the server log.
# Any SMTP provider works: Resend, AWS SES, Postmark, Mailgun.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=ReNest <no-reply@example.com>

# ── Media storage (optional S3 / Cloudflare R2) ──────────────────────
# Unset = local filesystem under backend/media/. Setting a bucket name
# switches uploads to remote storage (required on ephemeral-disk hosts).
# For R2: AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
# Optional CDN/custom domain for media (e.g. media.example.com)
AWS_S3_CDN_DOMAIN=
AWS_S3_QUERYSTRING_AUTH=0

# ── Web push (optional) ──────────────────────────────────────────────
# Generate a VAPID key pair, e.g.: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:admin@example.com

# ── Observability (optional) ─────────────────────────────────────────
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1
# DJANGO_LOG_LEVEL=INFO
# DJANGO_DB_LOG_LEVEL=WARNING
# DJANGO_JSON_LOGS=0

# ── Registration scoping (optional) ──────────────────────────────────
# Comma-separated email domains allowed to register. Empty = open.
CAMPUS_EMAIL_DOMAINS=

# ── Production security (enable all in production) ───────────────────
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
# DJANGO_SECURE_HSTS_PRELOAD=1
